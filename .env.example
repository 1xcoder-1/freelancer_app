# ==============================================================================
# FREELANCE BOOK MONOREPO ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API & PRIMARY DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Freelance Book API"
PORT=8000

# In Development (Local SQLite fallback):
DATABASE_URL=sqlite+aiosqlite:///./freelance_book.db
# In Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. OBJECT & MEDIA STORAGE (Cloudinary / Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=cloudinary

# Cloudinary Credentials (Dashboard > API Keys):
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Alternative Cloudflare R2 Settings:
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=freelance-book-assets
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Clerk)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-clerk-app.clerk.accounts.dev

# ------------------------------------------------------------------------------
# 4. FRONTEND APP CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 5. CACHE, BACKGROUND WORKFLOWS & EMAILS
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:token@your-redis.upstash.io:6379
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=noreply@freelancebook.com
BREVO_SENDER_NAME="Freelance Book"
INNGEST_EVENT_KEY=your_inngest_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ------------------------------------------------------------------------------
# 6. AI MODELS & ERROR OBSERVABILITY
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...
SENTRY_DSN=https://example@sentry.io/12345
