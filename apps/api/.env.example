APP_ENV=development
APP_NAME=Freelance Book API
DEBUG=True
PORT=8000

# Primary Database (Cloudflare D1 - Free Serverless SQL Database)
DATABASE_URL=sqlite+aiosqlite:///./freelance_book.db
CLOUDFLARE_ACCOUNT_ID=cf_account_id_example
CLOUDFLARE_D1_DATABASE_ID=cf_d1_db_id_example
CLOUDFLARE_API_TOKEN=cf_api_token_example

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_example
CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_ISSUER=https://clerk.your-domain.com

# Cache & Temporary Workloads (Upstash Redis)
REDIS_URL=rediss://default:password@upstash.io:6379

# Transactional Email (Brevo)
BREVO_API_KEY=xkeysib-example
BREVO_SENDER_EMAIL=noreply@freelancebook.com
BREVO_SENDER_NAME=Freelance Book

# Object & File Storage (Cloudflare R2)
R2_ACCOUNT_ID=account_id_example
R2_ACCESS_KEY_ID=access_key_example
R2_SECRET_ACCESS_KEY=secret_key_example
R2_BUCKET_NAME=freelance-book-assets
R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com

# Background Workflows (Inngest)
INNGEST_EVENT_KEY=inngest_event_key_example
INNGEST_SIGNING_KEY=inngest_signing_key_example

# AI Models
GEMINI_API_KEY=AIzaSy_example
OPENAI_API_KEY=sk-proj-example

# Error Monitoring
SENTRY_DSN=https://example@sentry.io/12345

# Optional Supabase
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
