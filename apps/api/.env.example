APP_ENV=development
APP_NAME=Freelance Book API
DEBUG=True
PORT=8000
SQL_ECHO=false

DATABASE_URL=
# Neon Postgres host choice (latency vs. connection pooling):
#  - POOLER host  (…ep-xxx-pooler-….neon.tech): pgbouncer transaction pooling.
#    Required when many connections are opened (e.g. many parallel dashboard
#    requests). Works with the engine's statement_cache_size=0 setting, but
#    transaction pooling adds a small per-query latency.
#  - DIRECT host  (…ep-xxx….neon.tech, NO "-pooler"): lowest latency — the best
#    choice on the Neon Free tier / single dev server. Because there is no
#    pooler, keep the SQLAlchemy pool small (pool_size=5, max_overflow=10) so
#    you never exceed the branch's connection limit.
# Choose deliberately; the app does not rewrite the hostname for you.

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

CLERK_SECRET_KEY=sk_test_example
CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Enable mock/dev auth bypass (mock_token_*, test_*) — development only.
# Must stay false/absent in production; the API refuses to boot if this is
# true while APP_ENV is not development.
ALLOW_DEV_AUTH=false

SENTRY_DSN=https://example@sentry.io/12345

# Background Jobs (Inngest) — serves GET/PUT/POST /api/inngest inside this
# app. Local dev flow: leave INNGEST_ENABLED=true, keep keys empty, start the
# Dev Server from the repo root (pnpm dev:jobs → http://localhost:8282), then
# run the API normally. Restarting the API under --reload re-registers the
# functions with the Dev Server — that's expected, not an error.
# Production: INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY are REQUIRED — the API
# refuses to boot with INNGEST_ENABLED=true outside development when the
# signing key is missing (the serve endpoint is public & must verify calls).
INNGEST_ENABLED=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Dev Server / cloud base URL override; empty = SDK default (localhost:8282 in dev)
INNGEST_BASE_URL=

# Transactional email for reminder jobs. Empty key = console provider: emails
# are printed to the API log and never sent (safe default in dev).
RESEND_API_KEY=
EMAIL_FROM=Freelance Book <notifications@yourdomain.com>
# Public web app origin — payment/portal links inside reminder emails
WEB_APP_URL=http://localhost:3000
