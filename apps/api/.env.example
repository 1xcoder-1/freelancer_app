APP_ENV=development
APP_NAME=Freelance Book API
DEBUG=True
PORT=8000
SQL_ECHO=false

DATABASE_URL=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

CLERK_SECRET_KEY=sk_test_example
CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Enable mock/dev auth bypass (mock_token_*, test_*) — development only.
# Must stay false/absent in production; the API refuses to boot if this is
# true while APP_ENV is not development.
ALLOW_DEV_AUTH=false

SENTRY_DSN=https://example@sentry.io/12345
