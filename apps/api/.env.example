APP_ENV=development
APP_NAME=Freelance Book API
DEBUG=True
PORT=8000

DATABASE_URL=

STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Alternative Cloudflare R2 Settings
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=freelance-book-assets
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

CLERK_SECRET_KEY=sk_test_example
CLERK_PUBLISHABLE_KEY=pk_test_example
CLERK_ISSUER=https://your-app.clerk.accounts.dev

REDIS_URL=rediss://default:token@your-redis.upstash.io:6379

BREVO_API_KEY=xkeysib-example
BREVO_SENDER_EMAIL=noreply@freelancebook.com
BREVO_SENDER_NAME=Freelance Book

INNGEST_EVENT_KEY=inngest_event_key_example
INNGEST_SIGNING_KEY=inngest_signing_key_example


GEMINI_API_KEY=AIzaSy_example
OPENAI_API_KEY=sk-proj-example

SENTRY_DSN=https://example@sentry.io/12345

# ==============================================================================
# 9. OPTIONAL SECONDARY SERVICES
# ==============================================================================
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
