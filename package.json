{
  "name": "freelance-book-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"yellow,cyan\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:api": "cross-env WATCHFILES_FORCE_POLLING=true apps\\api\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --reload-delay 0.5 --reload-dir apps/api/app --app-dir apps/api",
    "dev:jobs": "inngest dev -u http://127.0.0.1:8000/api/inngest",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop build",
    "db:migrate": "apps\\api\\.venv\\Scripts\\python.exe -m app.core.migrate",
    "graphify": "graphify . --code-only"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "wait-on": "^8.0.3"
  }
}
